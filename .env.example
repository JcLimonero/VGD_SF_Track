# Variables del despliegue (Coolify o docker compose). Copia este archivo a
# .env SOLO para pruebas locales; .env no se versiona. Los valores reales van
# en el vault y en las variables de entorno de Coolify, nunca en el repositorio.

# Token de proveedor de la API de Vanguardia. Lo agrega nginx a cada llamada a
# /api; el portal y el navegador nunca lo ven. Pide uno NUEVO al dueño de la
# API (los anteriores estuvieron en el repositorio y deben darse de baja).
API_PROVIDER_TOKEN=

# URL base de la API (opcional).
API_UPSTREAM=https://apisvanguardia.com:400

# Llave para firmar las sesiones. Al menos 32 caracteres aleatorios.
AUTH_SECRET=

# Contraseña de cada perfil compartido.
PASSWORD_CRABI=
PASSWORD_SALES_FORCE=

# Duración de la sesión en horas (opcional, 8 por defecto).
SESSION_HOURS=8

# Días que se conservan los logs de acceso de nginx (opcional, 15 por defecto).
LOG_RETENTION_DAYS=15
