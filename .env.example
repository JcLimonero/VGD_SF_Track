# Variables del despliegue (Coolify o docker compose). Copia este archivo a
# .env SOLO para pruebas locales; .env no se versiona. Los valores reales van
# en el vault y en las variables de entorno de Coolify, nunca en el repositorio.

# Llave para firmar las sesiones. Al menos 32 caracteres aleatorios.
AUTH_SECRET=

# Contraseña de cada perfil compartido.
PASSWORD_CRABI=
PASSWORD_SALES_FORCE=

# Duración de la sesión en horas (opcional, 8 por defecto).
SESSION_HOURS=8
